# Vidalune settings. After a change: sudo systemctl restart vidalune
# API keys and passwords are not set here: add them in the web interface (Admin → Server).

# Port and address the web interface listens on.
PORT=3000
HOST=0.0.0.0

# Direct HTTPS media listener and the public port forwarded to it.
DIRECT_TLS_PORT=8443
DIRECT_PUBLIC_PORT=8443

# Where libraries may be chosen from (comma-separated); / = anywhere on this computer. Choose the
# folders in the web interface (Admin → Libraries → Browse). When Vidalune may not read a folder,
# it shows the command that gives it access.
MEDIA_ROOTS=/

# Database, artwork cache, backups. Keep it on a disk with space.
DATA_DIR=/var/lib/vidalune

# Behind a reverse proxy: the number of proxies in front of Vidalune (1 for one proxy).
#TRUST_PROXY=1

# Minutes between automatic incremental scans (0 = only on changes and by hand).
#SCAN_INTERVAL_MINUTES=360

# debug | info | warn | error
#LOG_LEVEL=info
