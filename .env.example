# Velyx configuration — copy to .env and adjust. Never commit your real .env.
# This file contains no secrets: the TMDB API key, server name, server URL and metadata
# language are set in the web interface (Admin → Server) after you create your account.
# The cookie-signing secret is generated automatically and stored in the data volume.

# Host port for the web interface
VELYX_PORT=3000

# Host folders
DATA_PATH=./data
MOVIES_PATH=/srv/media/movies
TV_PATH=/srv/media/tv

# User/group that owns your media files (run `id` on the host)
PUID=1000
PGID=1000
TZ=Europe/Amsterdam

# Reverse proxy support: true when behind Nginx/Caddy/Traefik
TRUST_PROXY=false
# auto = Secure cookies when the request arrives over HTTPS
COOKIE_SECURE=auto

# Minutes between automatic incremental scans (0 = off)
SCAN_INTERVAL_MINUTES=360

# debug | info | warn | error
LOG_LEVEL=info

# Image used by docker-compose.yml (published by GitHub Actions)
VELYX_IMAGE=ghcr.io/iitssjstn/velyx:latest
